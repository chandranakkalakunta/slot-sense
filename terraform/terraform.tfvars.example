# SportSlotReservation — Terraform Variables (Example)
#
# Copy this file to terraform.tfvars and fill in actual values.
# terraform.tfvars is gitignored (contains environment-specific values).

project_id         = "sport-slot-dev"
project_number     = "707808711911"
organization_id    = "833112493322"
billing_account_id = "014A8C-586310-DE4575"
region             = "asia-south1"
zone               = "asia-south1-a"
environment        = "dev"
github_repository  = "chandranakkalakunta/slot-sense"
# Per-env base domain (ADR-0046) — one wildcard cert + DNS zone per project:
#   dev:  base_domain = "slotsense-dev.chandraailabs.com"
#         admin_host  = "admin.slotsense-dev.chandraailabs.com"
#   test: base_domain = "slotsense-test.chandraailabs.com"
#         admin_host  = "admin.slotsense-test.chandraailabs.com"
#   prod: base_domain = "slotsense.chandraailabs.com"
#         admin_host  = "admin.slotsense.chandraailabs.com"
# base_domain  = "slotsense.chandraailabs.com"
# admin_host   = "admin.slotsense.chandraailabs.com"
# artifact_repo_name  = "slot-sense-repo"
# bootstrap_image_tag = "bootstrap"
# enable_sms_alerts   = false  # true only after the "Coordinator SMS" channel exists and is phone-verified (sport-slot-dev sets true)
#
# Same-SHA promote: on the SOURCE env (usually standing dev), grant downstream
# CI principalSets reader on this AR so promote_image.sh can copy without rebuild.
# Example member for slot-sense-test-01 (project_number 543027201830):
# artifact_registry_reader_members = [
#   "principalSet://iam.googleapis.com/projects/543027201830/locations/global/workloadIdentityPools/github-actions-pool/attribute.repository/chandranakkalakunta/slot-sense",
# ]

