# Copy to .env.local (gitignored) and fill in. Never commit real passwords.
# Source: set -a && source tests/functional/.env.local && set +a

# Target env (ADR-0046 base domain — no Pattern-B suffixes)
FUNC_BASE_DOMAIN=slotsense-test.chandraailabs.com
FUNC_ADMIN_HOST=admin.slotsense-test.chandraailabs.com
FUNC_TENANT_SLUG=marina-skies
FUNC_PROJECT_ID=slot-sense-test-03

# Public Firebase Web API key for this GCP project (not a secret in the
# backend sense — same as SPA). From infrastructure/firebase-web-configs/
FUNC_FIREBASE_API_KEY=

# Resident or tenant_admin with password already set (not force-password gate)
FUNC_RESIDENT_EMAIL=
FUNC_RESIDENT_PASSWORD=

# Optional: pin facility; otherwise first active facility is used
FUNC_FACILITY_ID=

# Optional: expect this git SHA in /health build_id (promote verification)
FUNC_EXPECT_BUILD_ID=

# Optional skips
# FUNC_SKIP_AGENT=1
# FUNC_SKIP_BOOKING=1
