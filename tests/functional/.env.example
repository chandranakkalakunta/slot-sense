# Copy to .env.local (gitignored). Or use: ./scripts/run_functional.sh (interactive)

# Target env (ADR-0046)
FUNC_BASE_DOMAIN=slotsense-test.chandraailabs.com
FUNC_ADMIN_HOST=admin.slotsense-test.chandraailabs.com
FUNC_TENANT_SLUG=marina-skies
FUNC_PROJECT_ID=slot-sense-test-03

# Firebase Web API key — infrastructure/firebase-web-configs/<project>.json
FUNC_FIREBASE_API_KEY=

# Resident (required for most tests)
FUNC_RESIDENT_EMAIL=
FUNC_RESIDENT_PASSWORD=

# Platform admin (catalog + tenant provision mutations)
FUNC_PLATFORM_ADMIN_EMAIL=
FUNC_PLATFORM_ADMIN_PASSWORD=

# Tenant admin (daily overview)
FUNC_TENANT_ADMIN_EMAIL=
FUNC_TENANT_ADMIN_PASSWORD=

# Optional
FUNC_FACILITY_ID=
FUNC_EXPECT_BUILD_ID=
FUNC_CONCURRENCY_N=10

# Skips (1 = skip)
# FUNC_SKIP_AGENT=1
# FUNC_SKIP_BOOKING=1
# FUNC_SKIP_MUTATIONS=1
# FUNC_SKIP_CONCURRENCY=1
# FUNC_SKIP_VOICE=1
