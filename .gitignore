# Environment files
.env
.env.local
.env.*.local
*.env
!.env.example
# Functional suite credentials (S-FUNC)
tests/functional/.env.local
!tests/functional/.env.example

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/*.auto.tfvars
terraform/crash.log
terraform/crash.*.log
terraform/.tf.sh.log
# Lock file is committed for reproducibility — do NOT ignore
# terraform/.terraform.lock.hcl

