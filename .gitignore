*firebase-adminsdk*.json
*service-account*.json
*gcp-key*.json
gha-creds-*.json
.firebase/
firebase-debug.log
firebase-debug.*.log

# Secrets
*.key
*.pem
*.p12
secrets/

# Docker
*.dockerignore.bak

# Cloud Build
.last_image_tag

# drill-bootstrap.sh (PR-G) — per-environment output manifests (contain a
# temp admin password), state cache, and command logs.
bootstrap-output-*.md
.drill-bootstrap-state-*.env
.drill-bootstrap-*.cmdlog
.drill-bootstrap-*.timing
.drill-firebase-web-config-*.json

# OS
Thumbs.db
.DS_Store

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Phase audit logs (local only)
scripts/phase-*.txt

# Voice I/O live-check audio fixtures (Coordinator-supplied, may contain
# real speech — never committed; see scripts/voice/stt_live_check.py)
resources/voice_fixtures/*
!resources/voice_fixtures/.gitkeep

# Firebase configuration (build-time injected, capture only)
infrastructure/firebase-web-config.json
infrastructure/firebase-*.json
*.tfplan
